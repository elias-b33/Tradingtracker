# Required on Vercel
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_URL=https://tradingtracker.vercel.app
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional comma-separated additional origins
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional Google OAuth. Set both values or leave both blank.
# Authorized JavaScript origin: https://tradingtracker.vercel.app
# Authorized redirect URI: https://tradingtracker.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in is intentionally inactive; no Apple credentials are required.

# Optional stock providers. Alpaca batch IEX takes precedence for U.S. quotes;
# Finnhub also supplies cached company profiles/logos when configured.
FINNHUB_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
